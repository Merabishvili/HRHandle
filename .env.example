# =============================================================================
# Supabase
# =============================================================================

# Supabase project URL — found in Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — NEVER expose in client code, server-side only
# Rotate immediately if accidentally committed to git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local-only: overrides Supabase emailRedirectTo during sign-up.
# Do NOT add to Vercel — see CLAUDE.md.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# =============================================================================
# App
# =============================================================================

# Public URL — used as redirect base for OAuth callbacks + canonical metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Bearer secret for /api/cron/expire-vacancies. Generate a long random string.
# When unset, every cron call 401s (a startup warning is logged).
CRON_SECRET=a-long-random-string

# =============================================================================
# Email (Resend)
# =============================================================================

RESEND_API_KEY=re_your_api_key

# =============================================================================
# OAuth integrations
# =============================================================================

# Google OAuth — create credentials at console.cloud.google.com
# Scopes needed: calendar.events, userinfo.email
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft (Azure AD) OAuth — create app at portal.azure.com
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Zoom OAuth — create app at marketplace.zoom.us
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# Note: LinkedIn integration uses manual page-ID entry (no OAuth flow), so
# LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET are intentionally absent.

# =============================================================================
# CV parsing (Google Gemini)
# =============================================================================

# Optional. When unset, CV parsing returns parse_failed (a warning is logged).
GOOGLE_GEMINI_API_KEY=AIza...

# =============================================================================
# Cloudflare Turnstile (CAPTCHA)
# =============================================================================

# Site key — public, embedded in the browser bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Secret key — server-only. Used by lib/turnstile.ts to verify tokens on the
# public apply form. Do NOT add NEXT_PUBLIC_ prefix.
# (Login + sign-up use Supabase's CAPTCHA config separately.)
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# =============================================================================
# Sentry (error monitoring)
# =============================================================================

# Empty / unset disables Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
# Vercel build env only — used by the Sentry CLI for source-map upload.
# SENTRY_AUTH_TOKEN=sntrys_...

# =============================================================================
# PostHog (product analytics)
# =============================================================================

# Project API key (phc_...) — public, embedded in the browser bundle.
# Empty / unset disables PostHog entirely (no events sent).
# Set in production only; leave unset in .env.local to keep dev traffic out of
# production analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud. Defaults to https://eu.i.posthog.com when unset.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
